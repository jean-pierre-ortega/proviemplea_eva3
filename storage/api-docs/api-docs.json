    "paths": {
        "/admin/contactos": {
            "get": {
                "tags": [
                    "Administración"
                ],
                "summary": "Listar contactos solicitados",
                "description": "Retorna las solicitudes de contacto con empresa y persona asociadas.",
                "operationId": "a5f060bc7b6fa5377c1497af4ddcd2d7",
                "responses": {
                    "200": {
                        "description": "Listado de contactos obtenido correctamente"
                    }
                }
            },
            "post": {
                "tags": [
                    "Administración"
                ],
                "summary": "Crear contacto solicitado",
                "description": "Registra una solicitud de contacto entre una empresa y una persona.",
                "operationId": "5dbc342d1c62d99c382fd63d39ff2d4f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {},
                            "example": {
                                "empresa_id": 1,
                                "persona_id": 1,
                                "estado": "pendiente",
                                "notas_admin": "Empresa interesada en contactar al talento"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Contacto creado correctamente"
                    },
                    "500": {
                        "description": "Error interno del servidor"
                    }
                }
            }
        },
        "/admin/contactos/{id}": {
            "patch": {
                "tags": [
                    "Administración"
                ],
                "summary": "Actualizar contacto solicitado",
                "description": "Actualiza el estado o notas de una solicitud de contacto.",
                "operationId": "5783d5aacdc283ea7d5688d1124aa8d8",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {},
                            "example": {
                                "estado": "contactado",
                                "notas_admin": "Se realizó el primer contacto"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Contacto actualizado correctamente"
                    },
                    "404": {
                        "description": "Contacto no encontrado"
                    }
                }
            }
        },
